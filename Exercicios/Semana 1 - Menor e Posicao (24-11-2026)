for(auto i = a.begin(); i!=a.end(); i++){

    if(i == minimo){
        break;
    }
    posicao++;
}

cout<<"Menor valor: "<<*minimo
    <<'\n'<<"Posicao: "<<posicao<<'\n';
    return 0;
}
