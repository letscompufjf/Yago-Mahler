#include <iostream>
#include <bits/stdc++.h>

using namespace std;

int main()
{
ios::sync_with_stdio(false);
cin.tie(nullptr);


vector<vector<int>> a(5, vector<int>(5));

int ie;
int jota;
for(int i = 0; i<5; i++){
    for(int j = 0; j<5; j++){
        cin>>a[i][j];
        if(a[i][j] == 1){
            ie = i;
            jota = j;
        }
    }
}

int total = abs(2 - ie) + abs(2 - jota);
cout<<total<<'\n';

    return 0;
}
