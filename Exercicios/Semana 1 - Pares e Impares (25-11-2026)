#include <iostream>
#include<bits/stdc++.h>

using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin>>n;
    int num;
    vector<int> vpar;
    vector<int> vimpar;

    int i = 0;

    while(i<n){
    cin>>num;
    if(num%2 ==0){
        vpar.push_back(num);
    }else{
        vimpar.push_back(num);
    }
    i++;
    }

    sort(vpar.begin(), vpar.end());
    sort(vimpar.begin(), vimpar.end(), greater<>());

    for(int x:vpar) cout<<x<<'\n';
    for(int x:vimpar) cout<<x<<'\n';

    return 0;
}
